GROQ_API_KEY=gsk_replace_me

# ---------------------------------------------------------------------------
# 10. Graph behaviour -- every stage can be switched off to measure its value
# ---------------------------------------------------------------------------
# Rewrite follow-up questions into standalone ones using chat history.
# DP_ENABLE_CONTEXTUALIZE=true

# Self-critique the drafted answer, and replan if it is unsupported.
# DP_ENABLE_CRITIQUE=true

# How many times the graph may loop back to planning after a failed critique.
# DP_MAX_REPLANS=1

# How many times the graph may rewrite SQL after a database error.
# DP_SQL_MAX_REPAIRS=3

# LangGraph's safety valve against a pathological cycle.
# DP_RECURSION_LIMIT=40

# Turns of history fed to the contextualiser.
# DP_HISTORY_TURNS=6

# DP_MEMORY_ENABLED=true
# DP_MEMORY_PATH=./storage/checkpoints.sqlite

# DP_REQUIRE_SQL_APPROVAL=false

# DP_API_HOST=0.0.0.0
# DP_API_PORT=8000
# DP_API_URL=http://localhost:8000
